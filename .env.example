# Environment Configuration Template for GenStudio AI

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security (Change in production)
JWT_SECRET=genstudio_super_secret_jwt_key_2026_academic_eval_secure_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local SQLite for zero-setup execution.
# PostgreSQL alternative: postgresql+psycopg2://postgres:postgres@localhost:5432/genstudio
DATABASE_URL=sqlite:///./genstudio.db

# Redis & Background Queue (Optional)
REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=False

# Media Storage
MEDIA_STORAGE_DIR=./storage/media
MAX_UPLOAD_SIZE_BYTES=26214400

# AI Inference Providers (Server-side secrets)
# PROVIDER_MODE determines execution behavior:
# - live: real external inference only (fails honestly if keys missing; zero mock fallback)
# - offline-preview: clearly labeled synthetic preview mode for offline demo
# - test: deterministic fixtures for automated pytest suite
PROVIDER_MODE=live

# Hugging Face User Access Token (read permission is sufficient for inference)
HF_API_TOKEN=

# Google Gemini API Key for Prompt Engineering (from Google AI Studio)
GEMINI_API_KEY=

# Optional: Local ComfyUI Server endpoint
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Next.js Frontend Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
